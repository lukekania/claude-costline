{
  "statusLine": {
    "type": "command",
    "command": "~/.claude/costline/bin/statusline.sh",
    "padding": 0
  },
  "hooks": {
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 -I \"$HOME/.claude/costline/bin/costline.py\" hook",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
